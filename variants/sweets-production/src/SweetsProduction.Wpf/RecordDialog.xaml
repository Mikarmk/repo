<Window x:Class="ExamScaffold.Wpf.RecordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка записи"
        Height="360"
        Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Название" />
        <TextBox x:Name="TitleTextBox" Margin="0,22,0,12" Height="28" />

        <TextBlock Grid.Row="1" Text="Подзаголовок" />
        <TextBox x:Name="SubtitleTextBox" Grid.Row="1" Margin="0,22,0,12" Height="28" />

        <TextBlock Grid.Row="2" Text="Описание" />
        <TextBox x:Name="DescriptionTextBox" Grid.Row="2" Margin="0,22,0,12" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />

        <TextBlock x:Name="HintTextBlock"
                   Grid.Row="3"
                   Foreground="SteelBlue"
                   Text="Этот шаблонный диалог подготовлен под быструю адаптацию предметной формы варианта." />

        <Button Grid.Row="4"
                Content="Закрыть"
                Width="120"
                Height="34"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Click="CloseButton_OnClick" />
    </Grid>
</Window>
