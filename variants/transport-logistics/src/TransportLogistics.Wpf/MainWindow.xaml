<Window x:Class="ExamScaffold.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Главное окно"
        Height="620"
        Width="1024"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="WelcomeTextBlock" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="RoleTextBlock" Margin="16,0,0,0" VerticalAlignment="Center" />
            <Button Content="Профиль" Margin="16,0,0,0" Width="100" Click="ProfileButton_OnClick" />
            <Button Content="Добавить" Margin="8,0,0,0" Width="100" Click="AddButton_OnClick" />
            <Button Content="Редактировать" Margin="8,0,0,0" Width="120" Click="EditButton_OnClick" />
            <Button Content="Обновить" Margin="8,0,0,0" Width="100" Click="RefreshButton_OnClick" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Поиск" VerticalAlignment="Center" />
            <TextBox x:Name="SearchTextBox" Width="260" Margin="8,0,0,0" TextChanged="SearchTextBox_OnTextChanged" />
        </DockPanel>

        <DataGrid x:Name="RecordsDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Подзаголовок" Binding="{Binding Subtitle}" Width="2*" />
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*" />
                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="*" />
                <DataGridTextColumn Header="Значение" Binding="{Binding NumericValue}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
