<Window x:Class="ExamScaffold.Wpf.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Профиль"
        Height="300"
        Width="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="FullNameTextBlock" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="RoleTextBlock" Grid.Row="1" Margin="0,12,0,0" />
        <TextBlock x:Name="LoginTextBlock" Grid.Row="2" Margin="0,12,0,0" />
        <TextBlock x:Name="ContactTextBlock" Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
