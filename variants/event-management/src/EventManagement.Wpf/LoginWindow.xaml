<Window x:Class="ExamScaffold.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация"
        Height="360"
        Width="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Text="Exam Scaffold"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1" Text="Логин" />
        <TextBox x:Name="LoginTextBox" Grid.Row="1" Margin="0,24,0,12" Height="30" />

        <TextBlock Grid.Row="2" Text="Пароль" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="2" Margin="0,24,0,12" Height="30" />

        <StackPanel x:Name="CaptchaPanel" Grid.Row="3" Visibility="Collapsed">
            <TextBlock x:Name="CaptchaTextBlock" FontWeight="Bold" />
            <TextBlock Text="Введите CAPTCHA" Margin="0,8,0,0" />
            <TextBox x:Name="CaptchaTextBox" Height="30" Margin="0,6,0,0" />
        </StackPanel>

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="4"
                   Margin="0,12,0,12"
                   Foreground="Firebrick" />

        <Button Grid.Row="5"
                Content="Войти"
                Height="36"
                Width="140"
                HorizontalAlignment="Left"
                Click="LoginButton_OnClick" />
    </Grid>
</Window>
