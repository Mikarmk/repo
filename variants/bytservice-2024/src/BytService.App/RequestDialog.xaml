<Window x:Class="BytService.App.RequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка заявки"
        Height="720"
        Width="720"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock FontSize="22" FontWeight="Bold" Text="Заявка" Grid.ColumnSpan="2" Margin="0,0,0,12" />

            <TextBlock Grid.Row="1" Text="Дата создания" VerticalAlignment="Center" />
            <DatePicker x:Name="CreatedAtDatePicker" Grid.Row="1" Grid.Column="1" />

            <TextBlock Grid.Row="2" Text="Тип техники" VerticalAlignment="Center" />
            <TextBox x:Name="ApplianceTypeTextBox" Grid.Row="2" Grid.Column="1" />

            <TextBlock Grid.Row="3" Text="Модель техники" VerticalAlignment="Center" />
            <TextBox x:Name="ApplianceModelTextBox" Grid.Row="3" Grid.Column="1" />

            <TextBlock Grid.Row="4" Text="Описание проблемы" VerticalAlignment="Center" />
            <TextBox x:Name="ProblemDescriptionTextBox" Grid.Row="4" Grid.Column="1" AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="5" Text="Клиент" VerticalAlignment="Center" />
            <ComboBox x:Name="ClientComboBox"
                      Grid.Row="5"
                      Grid.Column="1"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="UserId" />

            <TextBlock Grid.Row="6" Text="Статус" VerticalAlignment="Center" />
            <ComboBox x:Name="StatusComboBox" Grid.Row="6" Grid.Column="1" DisplayMemberPath="Value" SelectedValuePath="Value" />

            <TextBlock Grid.Row="7" Text="Ответственный мастер" VerticalAlignment="Center" />
            <ComboBox x:Name="MasterComboBox"
                      Grid.Row="7"
                      Grid.Column="1"
                      DisplayMemberPath="FullName"
                      SelectedValuePath="UserId" />

            <TextBlock Grid.Row="8" Text="Плановая дата завершения" VerticalAlignment="Center" />
            <DatePicker x:Name="PlannedCompletionDatePicker" Grid.Row="8" Grid.Column="1" />

            <TextBlock Grid.Row="9" Text="Дата завершения" VerticalAlignment="Center" />
            <DatePicker x:Name="CompletionDatePicker" Grid.Row="9" Grid.Column="1" />

            <TextBlock Grid.Row="10" Text="Использованные детали" VerticalAlignment="Center" />
            <TextBox x:Name="RepairPartsTextBox" Grid.Row="10" Grid.Column="1" AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <GroupBox x:Name="QualitySection" Grid.Row="11" Grid.ColumnSpan="2" Margin="0,16,0,0" Header="Функции менеджера по качеству">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Дополнительный мастер" VerticalAlignment="Center" />
                    <ComboBox x:Name="AssistantMasterComboBox"
                              Grid.Column="1"
                              DisplayMemberPath="FullName"
                              SelectedValuePath="UserId" />
                    <TextBlock Grid.Row="1" Text="Продлить до" VerticalAlignment="Center" />
                    <DatePicker x:Name="ExtendedUntilDatePicker" Grid.Row="1" Grid.Column="1" />
                    <CheckBox x:Name="ClientApprovedCheckBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Margin="4"
                              Content="Согласовано с клиентом" />
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Width="120" Click="CancelButton_OnClick" Content="Отмена" />
                <Button Width="140" Click="SaveButton_OnClick" Content="Сохранить" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
