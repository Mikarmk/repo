<Window x:Class="BytService.App.CommentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Комментарии по заявке"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeaderTextBlock" FontSize="20" FontWeight="Bold" />
        <DataGrid x:Name="CommentsDataGrid"
                  Grid.Row="1"
                  Margin="0,16,0,16"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=g}" Width="160" />
                <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="200" />
                <DataGridTextColumn Header="Комментарий" Binding="{Binding CommentText}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2">
            <TextBox x:Name="CommentTextBox"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="120" Click="CloseButton_OnClick" Content="Закрыть" />
                <Button x:Name="AddCommentButton" Width="180" Click="AddCommentButton_OnClick" Content="Добавить комментарий" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>

