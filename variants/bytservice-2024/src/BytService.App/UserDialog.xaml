<Window x:Class="BytService.App.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый пользователь"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="ФИО" VerticalAlignment="Center" />
        <TextBox x:Name="FullNameTextBox" Grid.Column="1" />

        <TextBlock Grid.Row="1" Text="Телефон" VerticalAlignment="Center" />
        <TextBox x:Name="PhoneTextBox" Grid.Row="1" Grid.Column="1" />

        <TextBlock Grid.Row="2" Text="Логин" VerticalAlignment="Center" />
        <TextBox x:Name="LoginTextBox" Grid.Row="2" Grid.Column="1" />

        <TextBlock Grid.Row="3" Text="Пароль" VerticalAlignment="Center" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="4" />

        <TextBlock Grid.Row="4" Text="Роль" VerticalAlignment="Center" />
        <ComboBox x:Name="RoleComboBox" Grid.Row="4" Grid.Column="1">
            <ComboBoxItem Tag="OPERATOR" Content="Оператор" />
            <ComboBoxItem Tag="MASTER" Content="Мастер" />
            <ComboBoxItem Tag="CLIENT" Content="Заказчик" />
            <ComboBoxItem Tag="QUALITY_MANAGER" Content="Менеджер по качеству" />
        </ComboBox>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Width="120" Click="CancelButton_OnClick" Content="Отмена" />
            <Button Width="160" Click="SaveButton_OnClick" Content="Создать" />
        </StackPanel>
    </Grid>
</Window>

