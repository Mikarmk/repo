<Window x:Class="BytService.App.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR-код для отзыва"
        Height="460"
        Width="380"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderTextBlock" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
        <Border Margin="0,20,0,20" Padding="16" CornerRadius="12" Background="White">
            <Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" />
        </Border>
        <TextBlock x:Name="UrlTextBlock" TextWrapping="Wrap" Foreground="#4B5563" />
        <Button Width="120" HorizontalAlignment="Right" Click="CloseButton_OnClick" Content="Закрыть" />
    </StackPanel>
</Window>

