<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="AppDb" connectionString="Data Source=localhost\SQLEXPRESS;Initial Catalog=PartnerRequests2025Demo;Integrated Security=True;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="ApplicationTitle" value="Partner Requests 2025 Demo" />
